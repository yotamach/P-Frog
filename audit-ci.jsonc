{
  // Fail CI on HIGH and CRITICAL vulnerabilities in production dependencies.
  // Allowlisted advisories are unfixable transitive issues with low exploitability:
  //   1113459, 1113538, 1113546 — minimatch ReDoS via swagger-jsdoc > glob > minimatch
  //     Upstream swagger-jsdoc@6.2.8 (latest) pins glob@7.1.6 with no update available.
  //     The glob patterns are sourced from app config, not user input, so ReDoS is not exploitable.
  "high": true,
  "allowlist": [1113459, 1113538, 1113546],
  "package-manager": "yarn"
}
